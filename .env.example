# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=AI-OpsPilot
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# ── Backend API ───────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_PREFIX=/api/v1

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://opspilot:opspilot@localhost:5432/opspilot
SYNC_DATABASE_URL=postgresql://opspilot:opspilot@localhost:5432/opspilot

# ── Ollama LLM ────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── ChromaDB (RAG vector store) ───────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=runbooks

# ── Anomaly Detection ────────────────────────────────────────────────────────
ANOMALY_CONTAMINATION=0.05
ANOMALY_WINDOW_SECONDS=300

# ── Frontend ──────────────────────────────────────────────────────────────────
STREAMLIT_BACKEND_URL=http://localhost:8000
